# DNS A/AAAA for this name must point to the server before Caddy starts.
KIGO_DOMAIN=kigo.example
# Public IPv4 advertised by built-in TURN.
KIGO_PUBLIC_IP=203.0.113.10
# Public native relay endpoint, normally the same host on TCP 9000.
KIGO_NATIVE_RELAY=kigo.example:9000

# Generate independent values with: openssl rand -hex 32
KIGO_NATIVE_RELAY_SECRET=replace-with-64-random-hex-characters
KIGO_TURN_SECRET=replace-with-another-64-random-hex-value

# The same UDP range must be allowed by the host/cloud firewall.
KIGO_TURN_MIN_PORT=49160
KIGO_TURN_MAX_PORT=50159
KIGO_TURN_MAX_ALLOCATIONS=512

# Optional image/network overrides.
KIGO_IMAGE=kigo:local
KIGO_CADDY_IMAGE=caddy:2.10.2-alpine
KIGO_DOCKER_SUBNET=172.30.77.0/24
KIGO_CADDY_IP=172.30.77.2
KIGO_APP_IP=172.30.77.3
KIGO_RELAY_IP=172.30.77.4
