# Web/signaling service. Put TLS in a reverse proxy, or set KIGO_TLS_CERT and KIGO_TLS_KEY.
KIGO_LISTEN=:9100
KIGO_PUBLIC_URL=https://kigo.example
# Public TCP relay endpoint offered when both peers are installed native clients.
KIGO_NATIVE_RELAY=relay.example.com:9000
# Must match KIGO_RELAY_TOKEN_SECRET on the native relay. Keep this server-side.
KIGO_NATIVE_RELAY_SECRET=change-native-relay-secret
KIGO_NATIVE_RELAY_CREDENTIAL_TTL=2h

# Built-in TURN. Use a real public IP or leave KIGO_TURN_LISTEN empty when using external TURN.
KIGO_TURN_LISTEN=0.0.0.0:3478
KIGO_TURN_PUBLIC_IP=203.0.113.10
KIGO_TURN_USER=kigo
KIGO_TURN_SECRET=change-me
KIGO_TURN_REALM=kigo
KIGO_TURN_CREDENTIAL_TTL=2h
KIGO_TURN_CREDENTIALS_PER_MINUTE=1200
KIGO_TURN_MIN_PORT=49160
KIGO_TURN_MAX_PORT=50159
KIGO_TURN_MAX_ALLOCATIONS=512
KIGO_TURN_MAX_ALLOCATIONS_PER_USER=4
KIGO_TURN_MAX_ALLOCATIONS_PER_IP=32
KIGO_TURN_EGRESS_WINDOW=1h
KIGO_TURN_MAX_EGRESS_MIB=-1
KIGO_TURN_MAX_EGRESS_MIB_PER_USER=-1
KIGO_TURN_MAX_EGRESS_MIB_PER_IP=-1

# External TURN alternative:
# KIGO_TURN=turn:turn.example:3478
# KIGO_TURN_SECRET=the-coturn-static-auth-secret

# Direct TLS alternative:
# KIGO_TLS_CERT=/etc/kigo/cert.pem
# KIGO_TLS_KEY=/etc/kigo/key.pem

# When HTTP is behind a reverse proxy, trust only that proxy's IP/CIDR so
# per-client rate limits can safely use X-Forwarded-For.
# KIGO_TRUSTED_PROXIES=127.0.0.1/32
